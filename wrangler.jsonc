{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Terraform in jnsgruk/infra binds the domain to this Worker name.
  "name": "website",
  // Keep route/routes omitted: Terraform owns custom domains and DNS.
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
